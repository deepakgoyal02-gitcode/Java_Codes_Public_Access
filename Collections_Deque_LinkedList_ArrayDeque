        ll2.push("Japan");
        System.out.println(ll2.pop()); //pop will add element to top i.e. the front/start of the list
        System.out.println(ll2.peek());

        Iterator<String> it = ll2.iterator(); //Iterator will work on ArrayDeque but list-iterator will not
        while(it.hasNext())
            System.out.print(it.next() + ", ");
