import java.util.*;

class Main1 {
    public static void main(String[] args) {

        TreeSet<String> mySet = new TreeSet<>();

        // add()
        mySet.add("Orange");
        mySet.add("Apple");
        mySet.add("Banana");
        mySet.add("Mango");

        mySet.add("Apple");

//        Because String already overrides: hashCode(), equals() (Of Object Class)
//        So HashSet identifies duplicate String values automatically.

        // print HashSet
        System.out.println(mySet);

        // size()
        System.out.println(mySet.size());

        // contains()
        System.out.println(mySet.contains("Mango"));

        // remove()
        mySet.remove("Banana");

        // isEmpty()
        System.out.println(mySet.isEmpty());

        // iterate using for-each
        for (String fruit : mySet) {
            System.out.println(fruit);
        }

        // clear()
        mySet.clear();

        System.out.println(mySet);

    }
}
class Employee  implements Comparable<Employee>
{
    int empID;
    String empName;
    double empSalary;

    Employee(int pEmpID, String pEmpName, double pEmpSalary)
    {
        empID = pEmpID;
        empName = pEmpName;
        empSalary = pEmpSalary;
    }

    public int myDoubleCompare(double oEmpSalary)
    {
        if(this.empSalary > oEmpSalary)
            return +1;
        if(this.empSalary < oEmpSalary)
            return -1;
        return 0;
    }

    @Override
    public int compareTo(Employee o) {
        return myDoubleCompare(o.empSalary);
    }

    @Override
    public String toString() {
        return "Employee{" +
                "empID=" + empID +
                ", empName='" + empName + '\'' +
                ", empSalary=" + empSalary +
                '}';
    }
    @Override
    public boolean equals(Object obj) //to let java know when will we consider a user-defined object to be equal using hashcode()
    {

        if (this == obj)
            return true;

        if (obj == null || getClass() != obj.getClass())
            return false;

        Employee e = (Employee) obj;
        return this.empID == e.empID;
    }

    @Override
    public int hashCode() {
        return Integer.hashCode(empID);
    }
}

