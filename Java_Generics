class Box
{
    int value;
    void setValue(int value) {
        this.value = value;
    }
    int getValue() {
        return value;
    }
}

class GenBox<T>
{
    T value;
    void setValue(T value) {
        this.value = value;
    }
    T getValue() {
        return value;
    }
}

class Pair<K, V>
{
    K key;
    V value;
    Pair(K key, V value) {
        this.key = key;
        this.value = value;
    }
    void display() {
        System.out.println("Key: " + key);
        System.out.println("Value: " + value);
    }
}


class ObjectBox {
    Object value;
    void setValue(Object value) {
        this.value = value;
    }
    Object getValue() {
        return value;
    }
}

