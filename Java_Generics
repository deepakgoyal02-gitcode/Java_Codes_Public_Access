import java.util.*;
//Strong typing -- Type rules restrict incompatible operations and conversions.
//Java is commonly described as strongly typed.

class wildCard
{
    static void display(List<?> list)
    {
        for (Object item : list)
            System.out.println(item);
    }

    //extends is for reading - Number or below Number - Upper limit of class is Number
    static double sum(List<? extends Number> list)
    {
        double total = 0;
        for (Number n : list) {
            total += n.doubleValue();
        }
        return total;
    }

    //super is for adding - Integer or above Integer - Lower limit of class is Integer - Integer/Number/Object
    static void addNumbers(List<? super Integer> list) {
        list.add(10);
        list.add(20);
    }

    public static void main(String[] args)
    {
        // 1. Demonstrate List<?>
        List<String> names = Arrays.asList("Alice", "Bob", "Charlie"); //convert array to list
        System.out.println("Displaying strings:");
        display(names);

        // 2. Demonstrate List<? extends Number>
        List<Integer> numbers = Arrays.asList(10, 20, 30);
        System.out.println("\nSum of integers: " + sum(numbers));

        List<Double> decimals = Arrays.asList(1.5, 2.5, 3.5);
        System.out.println("Sum of doubles: " + sum(decimals));

        // 3. Demonstrate List<? super Integer>
        List<Number> numberList = new ArrayList<>();
        addNumbers(numberList);

        System.out.println("\nAfter adding integers:");
        display(numberList);
    }
}
