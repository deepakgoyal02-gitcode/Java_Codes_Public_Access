import java.util.*;
class Student implements Comparable<Student>
{
    int id;
    String name;
    double GPA;

    Student(int pID,String pName,double pGPA)
    {
        id = pID;
        name = pName;
        GPA = pGPA;
    }

    @Override
    //meaning if this.id > s.id then the above will return a +ve value
    //+VE VALUE MEANS THAT THE SWAP IS REQUIRED
    //because of current element is bigger than the next in line
    //swap is required so that we can put the bigger element at the back
    public int compareTo(Student o) {
        if(this.GPA < o.GPA)
            return -1;
        if(this.GPA > o.GPA)
            return 1;
        if(this.GPA == o.GPA)
        {
            return o.name.compareTo(this.name);
        }
        return 0;
    }

    @Override
    // In built types can be printed normally because they override toString() in them
    // but user-defined types will require explicit toString() override by programmer
    public String toString() {
        String toPrint = "id" + " " + GPA + " " + name + ", " ;
        return toPrint;
    }
}

